{
  "name": "@coderbyheart/aws-dynamodb-es-cqrs",
  "version": "0.0.0-development",
  "description": "ES/CQRS using AWS DynamoDB",
  "homepage": "https://github.com/coderbyheart/aws-dynamodb-es-cqrs",
  "bugs": {
    "url": "https://github.com/coderbyheart/aws-dynamodb-es-cqrs/issues"
  },
  "license": "MIT",
  "author": "Markus Tacker <m@coderbyheart.com> | https://coderbyheart.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderbyheart/aws-dynamodb-es-cqrs.git"
  },
  "files": [
    "npm"
  ],
  "type": "module",
  "imports": {
    "#aggregate/*": {
      "import": {
        "aws-dynamodb-es-cqrs-dev": "./aggregate/*",
        "default": "./npm/aggregate/*"
      }
    },
    "#event/*": {
      "import": {
        "aws-dynamodb-es-cqrs-dev": "./event/*",
        "default": "./npm/event/*"
      }
    },
    "#error/*": {
      "import": {
        "aws-dynamodb-es-cqrs-dev": "./error/*",
        "default": "./npm/error/*"
      }
    },
    "#persistence/*": {
      "import": {
        "aws-dynamodb-es-cqrs-dev": "./persistence/*",
        "default": "./npm/persistence/*"
      }
    }
  },
  "exports": {
    "./aggregate": {
      "import": {
        "types": "./npm/aggregate/export.d.ts",
        "default": "./npm/aggregate/export.js"
      }
    },
    "./event": {
      "import": {
        "types": "./npm/event/export.d.ts",
        "default": "./npm/event/export.js"
      }
    },
    "./error": {
      "import": {
        "types": "./npm/error/export.d.ts",
        "default": "./npm/error/export.js"
      }
    },
    "./persistence": {
      "import": {
        "types": "./npm/persistence/export.d.ts",
        "default": "./npm/persistence/export.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky",
    "test": "node --no-warnings --conditions=aws-dynamodb-es-cqrs-dev --test \"!(node_modules)/**/*.spec.ts\"",
    "test:watch": "node --no-warnings --conditions=aws-dynamodb-es-cqrs-dev --test --watch \"!(node_modules)/**/*.spec.ts\"",
    "prepublishOnly": "node --experimental-strip-types ./.npm/compile.ts && npx tsc -P ./.npm/tsconfig.npm.json --outDir ./npm"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1176.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@bifravst/cloudformation-helpers": "10.0.3",
    "@coderbyheart/oxlint-config": "1.0.1",
    "@commitlint/config-conventional": "21.2.4",
    "@swc/core": "1.16.22",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.7",
    "commitlint": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@bifravst/from-env": "4.0.1",
    "ulidx": "2.4.1"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{md,json,yaml,yml}": [
      "oxfmt --write"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=12.2.2 <13"
  }
}
